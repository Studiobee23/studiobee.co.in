# CRITICAL: this project deploys via `vercel` CLI, which uploads the raw
# working directory and does NOT respect .gitignore the way git-based
# deploys do. Anything not listed here is served as a public static file.
# When adding a new top-level file/folder that isn't meant to be public,
# add it here too — .gitignore alone provides zero protection in prod.

# Secrets
smtp-config.json
smtp-config.json.example
.env
.env.*

# Runtime data / PII
contacts.json
analytics.json
presence.json

# Local dev / build tooling — not needed at runtime on Vercel
serve.mjs
screenshot.mjs
migrate-storage.mjs
generate-casestudy.mjs
railway.json

# Separate app — has its own independent Vercel project/deployment
mystudiobee/

# Internal docs / schema (reveal DB structure and business info)
docs/
design-guide.md
SNAP-DESIGN-SYSTEM-GUIDE.md
StudioBee_ProfitShare.docx
docx_out.txt
page-offsets.json
mcbee-analytics-30d.csv

